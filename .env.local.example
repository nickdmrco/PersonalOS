# Copy to .env.local and fill in from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated addresses allowed to hold an account. Server-only — no
# NEXT_PUBLIC_ prefix, so it never reaches the browser. Leave empty and the
# email link is still closed (shouldCreateUser: false), but an OAuth provider
# would not be. Set it before enabling one.
ALLOWED_EMAILS=

# --- weekly digest email (optional; the app works without all of these) ---
# Server-only, every one of them. None may carry a NEXT_PUBLIC_ prefix.
#
# A long random string — `openssl rand -hex 32`. Vercel attaches it to
# scheduled requests automatically when the variable has exactly this name.
# The digest route refuses to run at all if it is unset.
CRON_SECRET=
# Bypasses RLS. Used by the digest route and nowhere else. Set it as a Secret.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# A verified sender in Resend, e.g. dead-reckoning@yourdomain.com
DIGEST_FROM=
# Optional. The origin used for links in the mail; defaults to whatever host
# the scheduler happened to call, which may be a deployment URL rather than
# your domain.
APP_URL=
